# ==========================================
# SAARTHI ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==========================================

# Mobile App Environment (React Native / Expo)
EXPO_PUBLIC_APP_NAME=SAARTHI
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://api.saarthi.example.com
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Services Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/saarthi_db
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*

# AI & Knowledge Services
AI_MODEL_NAME=gemini-1.5-flash
ASI_KNOWLEDGE_BASE_ENDPOINT=https://asi.nic.in/api
